{
  "name": "polygres-sdk-effect",
  "version": "0.1.0",
  "description": "Effect-native TypeScript SDK for the Polygres Runtime API",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun run clean && bun build ./src/index.ts --outdir ./dist --target browser --format esm --packages external --sourcemap=external && bunx tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "lint": "bunx biome check . && bunx tsc --noEmit",
    "format": "bunx biome check --write .",
    "test": "bun test",
    "contracts:check": "bun run scripts/verify-contract.ts",
    "package:check": "bun run scripts/verify-package.ts",
    "check": "bun run contracts:check && bun run lint && bun test && bun run build && bun run package:check",
    "live:readiness": "bun run scripts/readiness.ts"
  },
  "keywords": [
    "effect",
    "polygres",
    "postgresql",
    "graph-search",
    "vector-search",
    "hybrid-search"
  ],
  "author": "Patrick Hall <phall1@users.noreply.github.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phall1/polygres-sdk-effect.git"
  },
  "bugs": {
    "url": "https://github.com/phall1/polygres-sdk-effect/issues"
  },
  "homepage": "https://github.com/phall1/polygres-sdk-effect#readme",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=20"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.112 <5"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@biomejs/biome": "2.5.11",
    "effect": "4.0.0-rc.112",
    "typescript": "7.0.2"
  }
}
